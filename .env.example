# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in your values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────────────────────

# ── Oracle sys/system password (internal to Docker, not used by the app) ──
ORACLE_SYS_PASSWORD=SysOracle#2024

# ── Application DB password (used by both oracle-init.sh and the app) ─────
DB_PASS=BiisPass#2024

# ── JWT signing secret — change this to a long random string ──────────────
JWT_SECRET=change_me_to_a_long_random_secret_string_at_least_32_chars

# ── App port exposed on the host ───────────────────────────────────────────
PORT=3000

# ── Node environment ───────────────────────────────────────────────────────
NODE_ENV=production
